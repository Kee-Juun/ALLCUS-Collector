# Python cache/build output
.git/
.git_upload/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments and local environment files
.venv/
venv/
env/
.env
.env.*

# PyInstaller output
build/
dist/

# Local/generated runtime data
tmp/
tmp_*/
outputs/
logs/
*.log

# Accidental packaged/vendor artifacts copied into the project root
win32/
win32com/
*.pyd
*.pyd.backup

# Excel/user run artifacts
~$*.xlsx
*.xlsm
*.bak
